# BrokerRPCMon NL configuration

NL_ID="NL01"

BROKER_NAME="ETBSAPSSL"
BROKER_HOST="hv-server.example.local"
BROKER_PORT="10052"
BROKER_SSL="Y"

RPC_SERVER_NAME="NL01RPC"
RPC_SERVER_CLASS="RPC"
RPC_SERVICE="CALLNAT"

SAG_HOME="/opt/softwareag"
EXX_HOME="/opt/softwareag/EntireX"
NAT_HOME="/opt/softwareag/Natural"

NATURAL_BIN=""
RPC_START_CMD=""
RPC_STOP_CMD=""

LOG_DIR="/var/log/brokerrpcmon"
RUN_DIR="/var/run/brokerrpcmon"

MAINTENANCE_LOCK="/var/run/brokerrpcmon/maintenance.lock"

WATCHDOG_INTERVAL="300"
RESTART_LIMIT_COUNT="3"
RESTART_LIMIT_WINDOW="1800"
BROKER_CHECK_TIMEOUT="30"
REGISTRATION_TIMEOUT="120"

BROKER_PING_HOST=""
BROKER_PING_PORT=""

LOG_DIR="/var/log/brokerrpcmon"
RUN_DIR="/var/run/brokerrpcmon"

NL_INVENTORY_FILE="/opt/brokerrpcmon/conf/nl_inventory.conf"

START_BROKER_CMD=""
STOP_BROKER_CMD=""

BROKER_START_TIMEOUT="120"
BROKER_STOP_TIMEOUT="120"
PORT_CHECK_TIMEOUT="60"
NL_REGISTRATION_OBSERVE_TIMEOUT="120"

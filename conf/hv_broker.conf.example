# BrokerRPCMon HV configuration

BROKER_NAME="ETBSAPSSL"
BROKER_HOST="localhost"
BROKER_PORT_CLEAR="10001"
BROKER_PORT_SSL="10052"

SAG_HOME="/opt/softwareag"
EXX_HOME="/opt/softwareag/EntireX"
EXXDIR="/usr/SAG/exx/v107/EntireX"
NAT_HOME="/opt/softwareag/Natural"

ETBINFO_BIN=""
ETBCMD_BIN=""
ETBSRV_BIN=""
